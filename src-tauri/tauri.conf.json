{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asciiary-tauri",
  "version": "0.1.0",
  "identifier": "com.alf.asciiary-tauri",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Asciiary",
        "width": 1080,
        "height": 680,
        "minWidth": 860,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0c0c0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
